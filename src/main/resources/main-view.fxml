<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ro.mpp2026.ui.MainController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="430">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Events"/>
            <TableView fx:id="eventsTable" prefHeight="320">
                <columns>
                    <TableColumn fx:id="eventIdColumn" text="ID" prefWidth="45"/>
                    <TableColumn fx:id="eventNameColumn" text="Event" prefWidth="170"/>
                    <TableColumn fx:id="eventMinAgeColumn" text="Min Age" prefWidth="70"/>
                    <TableColumn fx:id="eventMaxAgeColumn" text="Max Age" prefWidth="70"/>
                    <TableColumn fx:id="eventParticipantsColumn" text="Participants" prefWidth="100"/>
                </columns>
            </TableView>

            <Button text="Refresh" onAction="#handleRefresh"/>

            <Label text="Search by age group"/>
            <HBox spacing="10">
                <ComboBox fx:id="searchAgeGroupCombo" prefWidth="170"/>
                <Button text="Search" onAction="#handleSearch"/>
            </HBox>

            <Label text="Register child"/>
            <TextField fx:id="nameField" promptText="Name"/>
            <TextField fx:id="cnpField" promptText="CNP"/>
            <TextField fx:id="ageField" promptText="Age"/>
            <Button text="Register to selected events" onAction="#handleRegisterChild"/>

            <Label text="Modify registrations"/>
            <TextField fx:id="modifyCnpField" promptText="Child CNP"/>
            <Button text="Load child events" onAction="#handleLoadChildEvents"/>
            <Button text="Save changes" onAction="#handleModifyChild"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Children"/>
            <TableView fx:id="childrenTable" prefWidth="820" prefHeight="640">
                <columns>
                    <TableColumn fx:id="childIdColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="childNameColumn" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="childCnpColumn" text="CNP" prefWidth="180"/>
                    <TableColumn fx:id="childAgeColumn" text="Age" prefWidth="70"/>
                    <TableColumn fx:id="childEventsColumn" text="Registered events" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>